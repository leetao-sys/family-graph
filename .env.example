# 复制为 .env 后修改。所有密钥请使用足够长的随机值。
# 生成随机串示例：python -c "import secrets; print(secrets.token_urlsafe(48))"

DB_PASSWORD=change-me-db-password
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
ADMIN_USERNAME=admin
# 初始管理员密码（首次登录后强制修改）
ADMIN_PASSWORD=change-me-admin

# 对外端口；生产环境请在前面加 HTTPS 反向代理，并把 COOKIE_SECURE 设为 true
WEB_PORT=8080
COOKIE_SECURE=false
TOKEN_HOURS=12
MAX_UPLOAD_MB=5

# 自动备份
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14
BACKUP_HOUR=3
