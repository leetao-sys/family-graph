# 复制本文件为 .env 后修改；.env 不要提交到 git。
#
# 生成随机串（在开发机或 NAS 上执行）：
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# 注意：DB_PASSWORD 会被拼进数据库连接串，只能使用字母、数字、- 和 _。
# token_urlsafe 生成的值正好满足；不要使用含 @ : / % # 等字符的密码。

# 三个镜像放在同一个仓库里，用标签区分：backend-<版本>、web-<版本>、backup-<版本>
#   Docker Hub：       leetaooooo/family-graph
#   阿里云 ACR：        registry.cn-hangzhou.aliyuncs.com/你的命名空间/family-graph
#   离线导入的镜像：    family-graph
IMAGE_REPO=leetaooooo/family-graph
IMAGE_TAG=latest

# 数据库密码：留空会拒绝启动，请填 32 位左右的随机串
DB_PASSWORD=
# 会话签名密钥：留空会拒绝启动，请填 48 位左右的随机串
SECRET_KEY=

ADMIN_USERNAME=admin
# 初始管理员密码：建议 8 位以上并同时含字母和数字（首次登录会强制改成符合规则的密码）
ADMIN_PASSWORD=

# 对外端口；NAS 上 8080 被占用时（如 Web Station）改成 8081 等
WEB_PORT=8080
# 直接 http:// 访问必须为 false；套了 HTTPS 反向代理后改为 true
COOKIE_SECURE=false
TZ=Asia/Shanghai
TOKEN_HOURS=12
MAX_UPLOAD_MB=5

# 备份目录。相对路径相对于本文件所在目录；也可写 NAS 绝对路径，如 /volume1/backup/family-graph
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14
# 每天几点备份（0-23，按 TZ 时区）
BACKUP_HOUR=3
